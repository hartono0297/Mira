{
  "name": "mira",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "fixtures:sign": "node --experimental-strip-types --no-warnings scripts/make-sign-fixtures.mjs",
    "fixtures:sign-real": "node --experimental-strip-types --no-warnings scripts/make-sign-real-fixtures.mjs",
    "build:installer": "tauri build",
    "build:installer-offline": "tauri build --config src-tauri/tauri.offline.conf.json",
    "build:installer-mac": "tauri build --target universal-apple-darwin",
    "test:e2e": "node scripts/smoke-e2e.mjs src-tauri/target/release/mira.exe docs/progress/screenshots",
    "test:e2e-multi": "node scripts/e2e-multi.mjs src-tauri/target/release/mira.exe docs/progress/screenshots/tahap-1",
    "test:e2e-fitur-multi": "node scripts/e2e-fitur-multi.mjs src-tauri/target/release/mira.exe docs/progress/screenshots/fitur-multi",
    "test:e2e:docs": "node scripts/smoke-docs-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots test-files/docs",
    "test:e2e-ttd": "node scripts/sign-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots",
    "test:e2e-sync": "node scripts/sync-e2e.mjs src-tauri/target/release/mira.exe docs/progress/screenshots/sinkron",
    "test:e2e-chat": "node scripts/chat-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots",
    "test:e2e-board-v04": "node scripts/board-v04-multi-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots/v04-board",
    "test:e2e-english": "node scripts/english-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots/v04-english",
    "test:e2e-kopi": "node scripts/kopi-e2e.mjs src-tauri/target/debug/mira.exe docs/progress/screenshots/kopi"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tabler/icons-react": "^3.52.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
