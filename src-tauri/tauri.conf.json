{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mira",
  "mainBinaryName": "mira",
  "version": "0.3.0",
  "identifier": "id.mira.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mira",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Mira",
    "copyright": "Hak cipta (c) 2026 Mira",
    "category": "Productivity",
    "shortDescription": "Chat, board, dan dokumen tim di jaringan kantor",
    "longDescription": "Mira adalah aplikasi kerja tim untuk jaringan kantor (LAN) tanpa server dan tanpa internet. Anggota tim bisa mengobrol, mengatur board tugas per proyek, serta berbagi dan menandatangani dokumen PDF langsung antar komputer.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Indonesian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "customLanguageFiles": {
          "Indonesian": "nsis/Indonesian.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MUI1MDY3Q0U5M0NGODkKUldTSno1UE9aMUFiVjhZOW53cW9RU1p5L2lzYk9DelhPTkw1SGJmZ1RrU1dmZHV0NUFmaFpvMWUK",
      "endpoints": [
        "https://github.com/hartono0297/Mira/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
